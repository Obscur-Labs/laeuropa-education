# Copy this file to `.env.local` (for the setup script / local testing against Firebase)
# and add the same values in Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. NEVER prefix these with NEXT_PUBLIC_.

# Firebase console → Project settings → Service accounts → Generate new private key (JSON file)
FIREBASE_PROJECT_ID=la-europa
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@la-europa.iam.gserviceaccount.com
# The "private_key" value from the JSON file, on one line, in double quotes, keeping the \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\npaste-here\n-----END PRIVATE KEY-----\n"
# Cloudinary dashboard → API Keys → copy the "API environment variable" (free plan is enough)
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Your live address (used for share links and SEO)
SITE_URL=https://www.example.com

# Optional: email notification for new enquiries (free at resend.com)
# RESEND_API_KEY=
# RESEND_FROM=LA Europa Website <website@laeuropaeducation.com>
